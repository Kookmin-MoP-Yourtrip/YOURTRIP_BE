# 장애 격리 주실험(#197) 회차 실행 설정 — bulkhead-round.sh 가 읽는다.
#
# 이 파일을 results/ai-bulkhead/config.env 로 복사해 채운다(results/ 는 gitignore 대상이다).
# 비밀값은 여기 쓰지 않는다 — JWT 비밀키는 실행 때 SSM 에서 읽어 토큰 발급 프로세스에만 넘긴다.

# AWS
AWS_PROFILE=terraform-admin
AWS_REGION=ap-northeast-2
ASG_NAME=yourtrip-prod-asg
SSM_ARTIFACT_KEY_PARAM=/yourtrip/prod/artifact_key
# JWT 비밀키가 든 SSM SecureString (terraform/prod 의 ssm_parameter_path + /env/JWT_SECRET)
SSM_JWT_SECRET_PARAM=/yourtrip/prod/env/JWT_SECRET

# 비교 대상 JAR (아티팩트 버킷의 키, 형식 app/<SHA 7자리>.jar)
ARTIFACT_KEY_A=app/xxxxxxx.jar
ARTIFACT_KEY_B=app/47c0425.jar
# 비교 실험 C(#201) — B 에서 입장 제한을 끄고 AbortPolicy·큐 4 로 바꾼 측정 전용 브랜치의 JAR
ARTIFACT_KEY_C=app/eb9bce5.jar

# 부하 대상 — 운영 ALB 의 공개 도메인
BASE_URL=https://example.com

# 부하용 사용자 — 운영 DB 에 실제로 있어야 한다(인증 필터가 DB 에서 조회한다)
LOADTEST_USER_ID=
LOADTEST_USER_EMAIL=

# 배경 상세조회 대상 업로드 코스 ID 범위 — 측정 전 점검에서 운영 DB 로 확인한 값
DETAIL_ID_MIN=1
DETAIL_ID_MAX=1

# SSH — 앱 인스턴스(prod 키)와 k6 EC2(loadtest 키). 두 보안그룹 모두 개발자 IP 에서만 SSH 를 연다
PROD_SSH_KEY=terraform/prod/yourtrip-prod-ssh
K6_SSH_KEY=terraform/loadtest/yourtrip-loadtest-ssh
K6_HOST=
# k6 EC2 가 회차마다 맞출 저장소 버전(브랜치 이름이나 커밋). 측정 도중 스크립트를 고쳐도 따라간다
K6_GIT_REF=docs/#197-ai-bulkhead-loadtest
SSH_USER=ec2-user
