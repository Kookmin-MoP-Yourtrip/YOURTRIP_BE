#!/usr/bin/env bpftrace
/*
 * lettuce 이벤트루프 스레드(와 대조군 Tomcat 워커)가 "CPU를 얼마나 빨리 다시 얻는가"의 분포를 잰다.
 *
 * sample-schedstat.sh의 배정당 대기(대기 ns ÷ pcount)는 평균이라 꼬리를 못 보고, 대기가
 * 어디서 시작됐는지도 가르지 못한다. 여기서는 대기 구간을 시작 원인별로 나눠 히스토그램에 담는다.
 *
 *   wake    : 잠들어 있다가 깨워진 시각(sched_wakeup) → CPU에 올라간 시각(sched_switch next)
 *             = 소켓에 응답이 도착해 이벤트루프가 깨어난 뒤 실제로 돌기까지
 *   preempt : runnable인 채로 CPU에서 내려온 시각(sched_switch prev, 수면 비트 없음) → 다시 올라간 시각
 *             = 일하던 도중 다른 스레드에게 밀려나 런큐에서 기다린 시간
 *   run     : CPU에 올라간 시각 → 내려온 시각 = 한 번 얻었을 때 쥐고 있던 시간
 *
 * 해상도: 대기와 실행 길이는 lhist 두 벌에 담는다 — 100μs 간격(50ms까지)과 10μs 간격(2ms까지). 게이트에서
 * 합성 워크로드의 lettuce 대기가 100μs 미만에 몰려 100μs 간격으로는 p50·p90이 한 버킷에 뭉개졌다.
 * 요약기는 분위수가 2ms 미만이면 정밀 쪽을 쓴다.
 *
 * 선점 판별: 커널 6.1의 __trace_sched_switch_state()는 선점이면 TASK_REPORT_MAX(0x100)를,
 * 그 밖에 runnable(양보 등)이면 0을 보고한다. 하위 8비트(수면 상태 비트)가 0이면 둘 다
 * "아직 runnable"이다. 이 판별이 맞는지는 같은 창의 /proc nonvoluntary_ctxt_switches와 대조해
 * 검증한다(sample-sched-latency.sh, lettuce-dispatch-latency.md의 게이트 G2).
 *
 * 그룹은 정수 키다 — 1 = lettuce(lettuce-*), 2 = tomcat(http-nio-* = 워커·poller·acceptor).
 * 문자열 키를 쓰지 않는 것은 구버전 bpftrace가 길이가 다른 문자열 리터럴을 한 변수에 담으면
 * 타입 오류를 내기 때문이다. tomcat을 워커만으로 좁히지 않는 것은 sample-schedstat.sh의 tomcat
 * 그룹과 같은 집합이어야 게이트 G1·G2로 대조할 수 있기 때문이다(워커가 대부분이라 대조군으로서의
 * 의미는 같다).
 * 스레드 이름은 커널 comm(15자 절단) 기준이라 PID를 거르지 않아도 이 박스에서는 겹치지 않는다.
 *
 * 선점자(#207): lettuce가 선점으로 내려올 때 그 CPU에 올라가는 스레드(next)를 @preemptor[그룹]에 센다.
 *   0 = 분류 밖   1 = lettuce   2 = tomcat   3 = gc(G1)   4 = jit(C1/C2)   5 = VM Thread
 *   6 = 커널 스레드(ksoftirqd·kworker·migration·rcu)   7 = bpftrace 자신   9 = idle(pid 0 — 선점이면 나오지 않아야 한다)
 * VM Thread를 gc와 나누는 것은 Serial GC면 GC가 VM Thread에서 돌지만 safepoint 작업 일반도 거기서 돌기 때문이다.
 * GC·JIT 접두사는 JVM 버전·GC 종류에 따라 달라진다. 분류 밖은 @preemptor_other_comm[comm]으로 이름을 남겨,
 * 실제 앱에서 접두사 목록이 빠뜨린 스레드가 없는지 확인한다. 그룹 합계는 @out_preempt[1]과 같아야 한다.
 * next는 "비운 CPU를 차지한 스레드"이지 선점을 일으킨 스레드와 같다는 보장은 없다 — 그 대조는 따로 한다.
 *
 * 선점자 대조 두 가지(#207):
 *   @preempt_waker[선점자 그룹, 선점자를 마지막으로 깨운 쪽]  — 깨운 쪽은 sched_waking 컨텍스트로 판별.
 *       "lettuce가 깨운 워커에게 밀려난다"는 해석이 맞다면 [2, 1](tomcat, lettuce가 깨움)이 지배적이다.
 *   @preempt_lastwk / @preempt_not_lastwk[선점자 그룹]  — 선점자가 그 CPU로 마지막에 깨워진 스레드인가.
 *       맞으면 깨우기 → 전환 간격(@preempt_lastwk_gap_*)이 짧아야 깨어남 선점이다. 아니면 next는
 *       자리만 차지했고 선점은 다른 스레드나 틱이 일으켰다.
 *   두 맵의 그룹별 합은 각각 @preemptor와 같아야 한다.
 * 인터럽트 깊이(@irqd)는 softirq·hrtimer만 센다. 하드IRQ 핸들러 안의 깨우기는 드물다고 보고 넣지 않았다 —
 * 합성 게이트에서 lettuce가 깨우지 않는 모드의 [*, 1]이 0에 가까운지로 오귀속 크기를 확인한다.
 *
 * 사용:  sudo bpftrace -f json -B none trace-sched-latency.bt <duration-sec>
 *        (보통 sample-sched-latency.sh가 schedstat과 같은 창으로 묶어 부른다)
 */

BEGIN
{
	printf("READY\n");
}

// ---- 인터럽트 깊이(CPU별) — sched_waking의 waker 귀속에 쓴다
// bpftrace는 프로브를 하나씩 붙인다. entry만 붙고 exit는 아직인 틈에 들어온 인터럽트는 진입만 세져
// 깊이가 영구히 +1로 남는다 — 게이트(wake 모드)에서 한 CPU의 깨우기가 전부 인터럽트로 분류돼
// lettuce 50% / 인터럽트 50%로 갈렸다. 그래서 sched_switch마다 0으로 되돌린다: 문맥 전환은
// 인터럽트·softirq 처리 도중에는 일어나지 않으므로 전환 시점의 깊이는 반드시 0이다.
// 끝만 보이는 경우(추적 시작 시 이미 처리 중이던 인터럽트)에는 음수로 내려가지 않게 0에서 멈춘다.
tracepoint:irq:softirq_entry,
tracepoint:irq:irq_handler_entry,
tracepoint:timer:hrtimer_expire_entry
{
	@irqd[cpu] = @irqd[cpu] + 1;
}

tracepoint:irq:softirq_exit,
tracepoint:irq:irq_handler_exit,
tracepoint:timer:hrtimer_expire_exit
{
	if (@irqd[cpu] > 0) {
		@irqd[cpu] = @irqd[cpu] - 1;
	}
}

// ---- 누가 깨웠는가 — sched_waking은 try_to_wake_up() 진입, 즉 깨우는 쪽 컨텍스트에서 발생한다.
// sched_wakeup은 원격 깨우기(ttwu_queue)면 대상 CPU의 IPI 안에서 발생해 comm이 깨운 쪽이 아닐 수 있다.
// 인터럽트 안의 깨우기(parkNanos 타임아웃 = hrtimer, 네트워크 수신 = softirq)는 comm이 그때 끼어들기를
// 당한 스레드라 lettuce로 잘못 귀속될 수 있다 — irq(8)로 따로 둔다.
//   0 = 모름(추적 전에 깨워짐)   1 = lettuce   2 = tomcat   3 = 그 밖의 스레드   8 = 인터럽트 컨텍스트
tracepoint:sched:sched_waking
{
	$wg = 3;
	if (@irqd[cpu] > 0) { $wg = 8; }
	else if (strncmp(comm, "lettuce-", 8) == 0) { $wg = 1; }
	else if (strncmp(comm, "http-nio-", 9) == 0) { $wg = 2; }
	@waker_grp[args->pid] = $wg;
}

tracepoint:sched:sched_wakeup,
tracepoint:sched:sched_wakeup_new
{
	// CPU별로 마지막에 깨워져 들어온 스레드 — 선점을 "일으킨" 후보다. 깨어남 선점은 이 깨우기 안에서
	// 바로 그 CPU의 현재 스레드에 재스케줄을 건다. 이름과 무관하게 전부 남긴다(선점자가 누구든 대조하려고).
	// target_cpu는 int(32비트), 조회 쪽 cpu 내장변수는 uint64 — 키 타입이 다르면 맵 로드가 거부된다
	$tc = (uint64)args->target_cpu;
	@lastwk[$tc] = args->pid;
	@lastwk_ns[$tc] = nsecs;

	if (strncmp(args->comm, "lettuce-", 8) == 0 || strncmp(args->comm, "http-nio-", 9) == 0) {
		$tid = args->pid;
		// 이미 CPU 위에 있거나 런큐에서 기다리는 중이면 대기 시작 시각을 덮어쓰지 않는다
		if (@oncpu[$tid] == 0 && @qpre[$tid] == 0 && @qwake[$tid] == 0) {
			@qwake[$tid] = nsecs;
		}
	}
}

tracepoint:sched:sched_switch
{
	$now = nsecs;
	// 인터럽트 깊이 자가 복구 — 위 @irqd 설명 참고
	@irqd[cpu] = 0;

	// ---- CPU에서 내려오는 스레드
	$pg = 0;
	if (strncmp(args->prev_comm, "lettuce-", 8) == 0) { $pg = 1; }
	else if (strncmp(args->prev_comm, "http-nio-", 9) == 0) { $pg = 2; }
	if ($pg != 0) {
		$ptid = args->prev_pid;
		$on = @oncpu[$ptid];
		if ($on != 0) {
			$run = ($now - $on) / 1000;
			@run_us[$pg] = lhist($run, 0, 50000, 100);
			@run_fine_us[$pg] = lhist($run, 0, 2000, 10);
			@run_stat[$pg] = stats($run);
		}
		delete(@oncpu[$ptid]);
		// CPU에서 내려오는 스레드에 남은 깨어남 시각은 낡은 값이다. 커널 6.1은 이미 CPU 위에 있는 스레드를
		// 깨워도(unpark가 허가만 쌓는 경우) ttwu_runnable 경로로 sched_wakeup을 낸다. 추적 시작 전부터 돌던
		// 스레드는 @oncpu가 비어 있어 그 깨우기를 거르지 못하고, 지우지 않으면 다음 진짜 깨우기에서
		// "실행 + 수면" 전체가 대기로 잡힌다(게이트 wake 모드에서 tomcat 대기 5~23ms 이상값 약 50건).
		delete(@qwake[$ptid]);
		if ((args->prev_state & 0xff) == 0) {
			@qpre[$ptid] = $now;
			@out_preempt[$pg] = count();
			if ($pg == 1) {
				// lettuce를 밀어내고 이 CPU에 올라가는 스레드를 그룹별로 센다(#207)
				$who = 0;
				if (args->next_pid == 0) { $who = 9; }
				else if (strncmp(args->next_comm, "lettuce-", 8) == 0) { $who = 1; }
				else if (strncmp(args->next_comm, "http-nio-", 9) == 0) { $who = 2; }
				else if (strncmp(args->next_comm, "GC Thread#", 10) == 0 ||
				         strncmp(args->next_comm, "G1 ", 3) == 0) { $who = 3; }
				else if (strncmp(args->next_comm, "C2 CompilerThre", 15) == 0 ||
				         strncmp(args->next_comm, "C1 CompilerThre", 15) == 0) { $who = 4; }
				else if (strncmp(args->next_comm, "VM Thread", 9) == 0) { $who = 5; }
				else if (strncmp(args->next_comm, "ksoftirqd/", 10) == 0 ||
				         strncmp(args->next_comm, "kworker/", 8) == 0 ||
				         strncmp(args->next_comm, "migration/", 10) == 0 ||
				         strncmp(args->next_comm, "rcu_", 4) == 0) { $who = 6; }
				else if (strncmp(args->next_comm, "bpftrace", 8) == 0) { $who = 7; }
				else {
					// 분류 밖 — 접두사 목록이 실제 박스와 맞는지 이 맵으로 확인한다
					@preemptor_other_comm[args->next_comm] = count();
				}
				@preemptor[$who] = count();

				// 선점자를 마지막으로 깨운 쪽 — "lettuce가 깨운 워커에게 밀려난다"면 [2, 1]이 지배적이어야 한다
				$nx = args->next_pid;
				@preempt_waker[$who, @waker_grp[$nx]] = count();

				// 선점자가 이 CPU로 마지막에 깨워진 스레드인가 — 아니면 next는 자리만 차지했을 뿐
				// 선점을 일으킨 것은 다른 스레드(또는 틱)다. 맞으면 깨우기 → 전환 간격을 본다:
				// 깨어남 선점이라면 μs 단위로 짧아야 한다.
				if ($nx != 0 && @lastwk[cpu] == $nx) {
					$gap = ($now - @lastwk_ns[cpu]) / 1000;
					@preempt_lastwk[$who] = count();
					@preempt_lastwk_gap_us = lhist($gap, 0, 2000, 10);
					@preempt_lastwk_gap_stat = stats($gap);
				} else {
					@preempt_not_lastwk[$who] = count();
				}
			}
		} else {
			@out_sleep[$pg] = count();
		}
	}

	// ---- CPU에 올라가는 스레드
	$ng = 0;
	if (strncmp(args->next_comm, "lettuce-", 8) == 0) { $ng = 1; }
	else if (strncmp(args->next_comm, "http-nio-", 9) == 0) { $ng = 2; }
	if ($ng != 0) {
		$ntid = args->next_pid;
		$p = @qpre[$ntid];
		$w = @qwake[$ntid];
		if ($p != 0) {
			$lat = ($now - $p) / 1000;
			@preempt_us[$ng] = lhist($lat, 0, 50000, 100);
			@preempt_fine_us[$ng] = lhist($lat, 0, 2000, 10);
			@preempt_stat[$ng] = stats($lat);
		} else if ($w != 0) {
			$lat = ($now - $w) / 1000;
			@wake_us[$ng] = lhist($lat, 0, 50000, 100);
			@wake_fine_us[$ng] = lhist($lat, 0, 2000, 10);
			@wake_stat[$ng] = stats($lat);
		} else {
			// 추적 시작 전에 대기에 들어간 배정 — 시작점을 모르므로 지연에서 뺀다
			@dispatch_unknown[$ng] = count();
		}
		delete(@qpre[$ntid]);
		delete(@qwake[$ntid]);
		@oncpu[$ntid] = $now;
		@dispatch[$ng] = count();
	}
}

interval:s:$1
{
	exit();
}

END
{
	// 진행 중 상태는 결과가 아니다 — 출력하지 않는다
	clear(@oncpu);
	clear(@qpre);
	clear(@qwake);
	clear(@irqd);
	clear(@waker_grp);
	clear(@lastwk);
	clear(@lastwk_ns);
}
