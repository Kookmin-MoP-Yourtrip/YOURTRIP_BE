{
  "uid": "ai-course-slot-vacancy",
  "title": "AI 코스 — 슬롯 결핍 관측 (#149)",
  "description": "장소를 채우지 못한 슬롯을 사유·타입별로 본다. 사유가 처방을 가른다 — duplicate는 후보 공급, grounding은 검증 로직, no_candidate는 소스 자체다.",
  "tags": [
    "yourtrip",
    "ai-course",
    "issue-149"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "결핍 — 슬롯이 비었는가",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "빈 슬롯 합계",
      "description": "네 사유의 합. 분모는 아래 '슬롯 채움 결과'의 세 값 합이다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "h": 6,
        "w": 5,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(ai_slot_vacant_total)",
          "legendFormat": "빈 슬롯",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "사유별 — 무엇을 고쳐야 하는가",
      "description": "duplicate: 후보 풀 확대 / day별 질의 분산 · grounding: 이름 게이트·검증 로직 · mixed: 어느 쪽도 단독 원인이 아님 · no_candidate: 후보 공급 소스(네이버·TourAPI)",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "h": 6,
        "w": 10,
        "x": 5,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (ai_slot_vacant_total)",
          "legendFormat": "{{reason}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "bargauge",
      "title": "슬롯 타입별 — 저녁이 얼마나 자주 빠지는가",
      "description": "meal 결손은 사용자에게 보이고 stroll 결손은 거의 안 보인다. 심각도가 이 축에서만 나온다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "h": 6,
        "w": 9,
        "x": 15,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "purple",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (slot) (ai_slot_vacant_total)",
          "legendFormat": "{{slot}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "빈 슬롯 발생 추이 (사유별)",
      "description": "increase()로 구간 발생량을 본다. 카운터라 누적값 자체보다 증가분이 읽기 쉽다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (increase(ai_slot_vacant_total[5m]))",
          "legendFormat": "{{reason}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "row",
      "title": "보정 — hit 은 실렸다는 뜻이 아니다",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 15
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "출처별 검증 성공 vs 실제 배치",
      "description": "ai.grounding.match 는 중복 제거보다 먼저 집계하므로 버려진 후보도 hit 으로 센다. hit − duplicate 가 그 출처의 실제 배치 수다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "seriesToColumns",
          "options": {
            "byField": "source"
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Value #A": "hit",
              "Value #B": "중복 폐기",
              "Value #C": "실제 배치"
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "instant": true,
          "expr": "sum by (source) (ai_grounding_match_total{result=\"hit\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          }
        },
        {
          "refId": "B",
          "format": "table",
          "instant": true,
          "expr": "sum by (source) (ai_grounding_duplicate_total)",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          }
        },
        {
          "refId": "C",
          "format": "table",
          "instant": true,
          "expr": "sum by (source) (ai_grounding_match_total{result=\"hit\"}) - sum by (source) (ai_grounding_duplicate_total)",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "piechart",
      "title": "그라운딩 결말 분포",
      "description": "환각률의 운영 프록시. no_result(순수 환각)와 failed(인프라)를 갈라 본다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value"
          ]
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "pieType": "donut"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (ai_grounding_match_total)",
          "legendFormat": "{{result}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          }
        }
      ]
    },
    {
      "id": 9,
      "type": "row",
      "title": "교차 검증 — 어긋나면 둘 중 하나가 버그다",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "no_candidate == unfilled",
      "description": "빈 choices 가 만들어지는 경로는 DeterministicCuration 의 UNFILLED 하나뿐이라 두 값은 항상 같아야 한다. 0 이 아니면 둘 중 하나가 버그다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              },
              {
                "color": "red",
                "value": -1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(ai_slot_vacant_total{reason=\"no_candidate\"}) - sum(ai_curation_slot_total{result=\"unfilled\"})",
          "legendFormat": "차이",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          }
        }
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "채운 슬롯 + 공석 = 전체",
      "description": "adopted(슬롯당 1개 배치) + vacant 가 전체 슬롯 수와 같아야 한다. 0 이 아니면 어느 갈래에도 안 들어간 빈 슬롯이 있다는 뜻이다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(ai_candidate_adopted_total) + sum(ai_slot_vacant_total)) - sum(ai_curation_slot_total)",
          "legendFormat": "차이",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          }
        }
      ]
    },
    {
      "id": 12,
      "type": "bargauge",
      "title": "슬롯 채움 결과 (분모)",
      "description": "curator: LLM 이 골랐다 · fallback: 코드가 후보 상위 3개로 채웠다 · unfilled: 후보 목록도 없었다. 세 값의 합이 전체 슬롯 수다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (ai_curation_slot_total)",
          "legendFormat": "{{result}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          }
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "ds_prom",
        "type": "datasource",
        "label": "Prometheus",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  }
}
