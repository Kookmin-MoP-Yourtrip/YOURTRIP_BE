{
  "type": "object",
  "properties": {
    "slots": {
      "type": "array",
      "description": "채울 자리마다 하나씩. 입력의 자리 순서를 그대로 따른다",
      "items": {
        "type": "object",
        "properties": {
          "slotIndex": {
            "type": "integer",
            "description": "채울 자리의 번호. 입력에 적힌 값을 그대로 적는다"
          },
          "choices": {
            "type": "array",
            "description": "그 자리에 넣을 후보 3개를 선호 순서로",
            "items": {
              "type": "object",
              "properties": {
                "listIndex": {
                  "type": ["integer", "null"],
                  "description": "목록에서 고른 항목의 번호(0부터). 목록 밖 제안이면 null"
                },
                "placeName": {
                  "type": ["string", "null"],
                  "description": "목록 밖 제안일 때만 실제 상호명. 목록에서 골랐으면 null"
                }
              },
              "required": ["listIndex", "placeName"],
              "additionalProperties": false
            }
          }
        },
        "required": ["slotIndex", "choices"],
        "additionalProperties": false
      }
    }
  },
  "required": ["slots"],
  "additionalProperties": false
}
