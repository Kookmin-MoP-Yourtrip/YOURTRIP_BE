# src/main/resources/application.yml 이 참조하는 환경변수 목록.
# 이 파일을 복사해 레포 루트에 .env로 저장한 뒤 실제 값을 채워 사용한다 (.env는 git에 커밋하지 않는다).
# spring-dotenv 의존성이 .env를 자동으로 읽어 환경변수로 주입하므로,
# 셸에서 직접 export할 필요 없이 ./gradlew bootRun만 실행하면 된다.
# (실제 OS 환경변수가 있으면 그 값이 항상 우선한다.)

# --- Database (PostgreSQL) ---
DB_URL=jdbc:postgresql://localhost:5432/yourtrip
DB_USERNAME=
DB_PASSWORD=
# Hibernate ddl-auto 정책: none | validate | update | create | create-drop
DB_DDL_AUTO=validate

# --- JWT ---
JWT_SECRET=

# --- Mail (Gmail SMTP) ---
MAIL_EMAIL=
MAIL_PASSWORD=

# --- Kakao (장소 검색용, 로그인은 미사용) ---
KAKAO_API_KEY=

# --- AWS S3 ---
S3_BUCKET=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=

# --- Gemini ---
GEMINI_API_KEY=

# --- Redis (인기 코스 캐싱 / 조회수 카운터) ---
# docker-compose.yml에서 호스트 포트를 6479로 매핑한다 (6379는 로컬에 네이티브 Redis가 떠 있을 수 있어 충돌 방지 목적으로 회피).
REDIS_HOST=localhost
REDIS_PORT=6479
