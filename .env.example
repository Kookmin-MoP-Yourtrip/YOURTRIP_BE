# src/main/resources/application.yml 이 참조하는 환경변수 목록.
# 일부 항목은 아직 application.yml이 참조하지 않고 후속 단계에서 연결된다 — 해당 항목에는
# 어느 단계에서 쓰이는지 주석으로 표시해뒀다.
# 이 파일을 복사해 레포 루트에 .env로 저장한 뒤 실제 값을 채워 사용한다 (.env는 git에 커밋하지 않는다).
# spring-dotenv 의존성이 .env를 자동으로 읽어 환경변수로 주입하므로,
# 셸에서 직접 export할 필요 없이 ./gradlew bootRun만 실행하면 된다.
# (실제 OS 환경변수가 있으면 그 값이 항상 우선한다.)

# --- Spring Profile ---
# 지정하지 않으면 local 프로필로 뜬다(application.yml의 spring.profiles.default).
# 로컬 개발에서는 비워두면 되고, 배포 서버에서만 prod로 지정한다.
# 배포 서버 적용 절차는 docs/guide/profile.md 참고.
#
# 주의: spring-dotenv가 이 .env를 읽는 시점이 프로필 결정보다 늦을 수 있어, 여기에
# SPRING_PROFILES_ACTIVE를 써도 프로필이 안 잡힐 수 있다. 로컬에서 prod를 흉내내려면
# 셸 환경변수로 직접 주는 편이 확실하다: SPRING_PROFILES_ACTIVE=prod ./gradlew bootRun
# SPRING_PROFILES_ACTIVE=prod

# --- Database (PostgreSQL) ---
DB_URL=jdbc:postgresql://localhost:5432/yourtrip
DB_USERNAME=
DB_PASSWORD=
# Hibernate ddl-auto 정책: none | validate | update | create | create-drop
DB_DDL_AUTO=validate

# --- JWT ---
JWT_SECRET=

# --- Mail (Gmail SMTP) ---
MAIL_EMAIL=
MAIL_PASSWORD=

# --- Kakao (장소 검색용, 로그인은 미사용) ---
KAKAO_API_KEY=

# --- AWS S3 ---
S3_BUCKET=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=

# --- CloudFront (이미지 URL 발급 — 공개 콘텐츠/mycourse Signed URL) ---
# terraform apply 이후 `terraform output`으로 나오는 값을 그대로 채운다 (terraform/README.md 참고).
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
# terraform/README.md 절차로 생성한 cloudfront_private_key.pem의 로컬 경로 (레포에 커밋하지 않음)
CLOUDFRONT_PRIVATE_KEY_PATH=
CLOUDFRONT_DISTRIBUTION_ID=

# --- Gemini (AI 코스 생성 — 현재 운영 중인 단일 호출 경로) ---
# 멀티 에이전트 파이프라인 도입 후 OpenAI로 교체되며, 그때까지는 before/after 비교 측정에
# 계속 필요하다 (docs/tasks/ai-course-create/ROADMAP.md 8단계에서 제거).
GEMINI_API_KEY=

# --- OpenAI (AI 코스 생성 멀티 에이전트 파이프라인) ---
# application.yml의 llm.openai.api-key가 참조한다(spring.ai.openai.* 가 아니다 —
# 어댑터가 OpenAiChatModel을 직접 조립하므로 설정이 llm.* 하나로 모인다).
#
# 비워둬도 앱은 정상 기동한다. 2단계 시점에는 이 어댑터가 프로덕션 경로에서 호출되지 않으므로
# 의도한 동작이며, 실제 호출 시점에만 실패한다. 8단계 스위치 이후에는 필수가 된다.
# 2-6 baseline 재측정을 돌리려면 지금도 값이 필요하다(없으면 측정이 스킵된다).
OPENAI_API_KEY=

# --- Naver 검색 API (장소 인기도/속성 신호) — NAVER API HUB ---
# 아직 application.yml이 참조하지 않는다. NaverBlogClient를 만드는 4단계에서 연결한다.
#
# 검색 API는 developers.naver.com이 아니라 네이버 클라우드 플랫폼(NCP)의 NAVER API HUB로 제공된다.
#   발급: NCP 콘솔 > NAVER API HUB에서 API 목록 중 "블로그(NAVER Search Blog API)"만 선택
#         (지역/뉴스/카페 등은 불필요 — 3·4층에 필요한 신호가 블로그 조회 한 번에 다 들어온다)
#   호출: https://naverapihub.apigw.ntruss.com
#   인증 헤더: X-NCP-APIGW-API-KEY-ID(=Client ID) / X-NCP-APIGW-API-KEY(=Client Secret)
#             ※ 구 방식의 X-Naver-Client-Id / X-Naver-Client-Secret 이 아니다.
#
# 요금은 0원이다(0~775,000건 구간). 다만 일 최대 25,000건 호출 제한이 있고, 코스 1건 생성에
# 약 35회를 호출하므로 하루 약 714건이 상한이다. 넘겨도 서비스는 죽지 않는다 — 네이버 신호는
# fail-open이라 인기도·속성만 빠지고 코스 생성은 계속된다.
# (docs/tasks/ai-course-create/steps/STEP-0-prerequisites.md 참고)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- Redis (인기 코스 캐싱 / 조회수 카운터) ---
# docker-compose.yml에서 호스트 포트를 6479로 매핑한다 (6379는 로컬에 네이티브 Redis가 떠 있을 수 있어 충돌 방지 목적으로 회피).
REDIS_HOST=localhost
REDIS_PORT=6479
